# =========================================================================
# FMB EXPÉRIENCE - FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT (.env.example)
# Ne mettez JAMAIS de vrais mots de passe ou clés privées dans ce fichier.
# Copiez ce fichier vers `.env.local` pour vos tests en local.
# =========================================================================

# 1. Supabase (URL et Clé Anonyme Publique)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# 2. Client ID PayPal (Identifiant public du marchand)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=votre_paypal_client_id

# 3. Resend (Clé secrète d'envoi d'emails - CÔTÉ SERVEUR UNIQUEMENT)
# ATTENTION : Ne JAMAIS préfixer par NEXT_PUBLIC_
RESEND_API_KEY=re_votre_cle_secrete_resend
